{
  "name": "JumpingGameWithMxt",
  "tree": {
    "$className": "DataModel",

    "ReplicatedFirst": {
      "$path": "src/ReplicatedFirst"
    },

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Events": {
        "$path": "src/Events"
      },
      "AnimationObjects": {
        "$path": "src/AnimationObjects"
      },
      "CharacterSounds": {
        "$path": "src/CharacterSounds"
      },
      "Vfx": {
        "$path": "src/Vfx"
      },
      "UpgradeData": {
        "$path": "src/UpgradeData"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "CharacterWalkSpeed": 20
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}